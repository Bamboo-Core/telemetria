###############################################################################
# Configuração de ambiente — copie para .env (o instalar.sh faz isso por você).
# NUNCA versione o .env (já está no .gitignore).
###############################################################################

# --- InfluxDB ---------------------------------------------------------------
# Deixe "trocar-me": o instalar.sh gera o token admin e preenche aqui.
INFLUX_TOKEN=trocar-me
INFLUX_DB=telemetria

# URL usada pelo Telegraf-Huawei (roda em network_mode: host → fala com a VM).
# O Telegraf-gNMI usa a rede interna do compose e ignora isto.
INFLUX_URL=http://127.0.0.1:8181

# --- Explorer ---------------------------------------------------------------
# Deixe "trocar-me": o instalar.sh gera um segredo aleatório.
SESSION_SECRET=trocar-me

# --- Imagem Huawei (opcional) -----------------------------------------------
# Por padrão baixa a imagem publicada no GHCR. Sobrescreva só se necessário.
# HUAWEI_IMAGE=ghcr.io/bamboo-core/telegraf-huawei:latest

# --- Credenciais gNMI (cadastro manual de equipamentos) ---------------------
# Use estas variáveis nos arquivos que você copiar de exemplos/ para telegraf.d/.
# Se equipamentos do mesmo fabricante usarem credenciais diferentes, crie um
# arquivo por equipamento e preencha direto nele (sem commitar).
JUNIPER_USER=
JUNIPER_PASS=
ARISTA_USER=
ARISTA_PASS=
CISCO_USER=
CISCO_PASS=
NOKIA_USER=
NOKIA_PASS=
